{
  "schemaVersion": 1,

  "id": "app-button",
  "name": "App Button",
  "slug": "app-button",

  "category": "Buttons",

  "description": "A production-ready reusable Flutter button supporting Material and Cupertino platforms.",

  "version": "1.0.0",

  "tags": [
    "button",
    "material",
    "cupertino",
    "loading",
    "icon",
    "responsive"
  ],

  "platforms": [
    "android",
    "ios",
    "web",
    "macos"
  ],

  "files": {
    "source": "app_button.dart",
    "readme": "README.md",
    "examples": "examples"
  },

  "parameters": [
    {
      "name": "label",
      "type": "string",
      "required": true,
      "defaultValue": "Button",
      "description": "Text displayed inside the button.",
      "ui": {
        "control": "text"
      }
    },

    {
      "name": "variant",
      "type": "enum",
      "required": false,
      "defaultValue": "primary",
      "options": [
        "primary",
        "secondary",
        "outline",
        "ghost",
        "danger"
      ],
      "description": "Visual style of the button.",
      "ui": {
        "control": "select"
      }
    },

    {
      "name": "isLoading",
      "type": "bool",
      "defaultValue": false,
      "description": "Shows a loading indicator instead of the button content.",
      "ui": {
        "control": "switch"
      }
    },

    {
      "name": "enabled",
      "type": "bool",
      "defaultValue": true,
      "description": "Controls whether the button can be pressed.",
      "ui": {
        "control": "switch"
      }
    },

    {
      "name": "expand",
      "type": "bool",
      "defaultValue": true,
      "description": "Expands the button to fill the available width.",
      "ui": {
        "control": "switch"
      }
    },

    {
      "name": "borderRadius",
      "type": "double",
      "defaultValue": 14,
      "description": "Controls the button corner radius.",
      "ui": {
        "control": "slider",
        "min": 0,
        "max": 40,
        "step": 1
      }
    },

    {
      "name": "backgroundColor",
      "type": "color",
      "defaultValue": null,
      "description": "Custom background color.",
      "ui": {
        "control": "color"
      }
    },

    {
      "name": "foregroundColor",
      "type": "color",
      "defaultValue": null,
      "description": "Custom foreground/text color.",
      "ui": {
        "control": "color"
      }
    },

    {
      "name": "borderColor",
      "type": "color",
      "defaultValue": null,
      "description": "Custom border color.",
      "ui": {
        "control": "color"
      }
    },

    {
      "name": "elevation",
      "type": "double",
      "defaultValue": null,
      "description": "Elevation of the Material button.",
      "ui": {
        "control": "slider",
        "min": 0,
        "max": 20,
        "step": 1
      }
    }
  ],

  "dependencies": [],

  "examples": [
    {
      "id": "basic",
      "name": "Basic",
      "file": "examples/basic.dart"
    },
    {
      "id": "variants",
      "name": "Variants",
      "file": "examples/variants.dart"
    },
    {
      "id": "loading",
      "name": "Loading",
      "file": "examples/loading.dart"
    },
    {
      "id": "icons",
      "name": "Icons",
      "file": "examples/icons.dart"
    },
    {
      "id": "customization",
      "name": "Customization",
      "file": "examples/customization.dart"
    }
  ],

  "author": {
    "name": "Suhas",
    "github": "suhasswamy6756"
  },

  "repository": {
    "type": "github",
    "path": "widgets/buttons/app-button"
  }
}